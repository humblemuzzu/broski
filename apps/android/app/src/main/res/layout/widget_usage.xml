<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_usage_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/usage_widget_empty"
        android:textColor="@color/widget_text_secondary"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_columns"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_column_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_glyph_1"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="6dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/widget_name_1"
                    style="@style/Widget.Broski.UsageName" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_label_1"
                style="@style/Widget.Broski.UsageCaption"
                android:layout_marginTop="10dp" />

            <TextView
                android:id="@+id/widget_left_1"
                style="@style/Widget.Broski.UsageFigure" />

            <ImageView
                android:id="@+id/widget_bar_1"
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:layout_marginTop="4dp"
                android:importantForAccessibility="no"
                android:scaleType="fitStart" />

            <TextView
                android:id="@+id/widget_reset_1"
                style="@style/Widget.Broski.UsageCaption"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_column_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_glyph_2"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="6dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/widget_name_2"
                    style="@style/Widget.Broski.UsageName" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_label_2"
                style="@style/Widget.Broski.UsageCaption"
                android:layout_marginTop="10dp" />

            <TextView
                android:id="@+id/widget_left_2"
                style="@style/Widget.Broski.UsageFigure" />

            <ImageView
                android:id="@+id/widget_bar_2"
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:layout_marginTop="4dp"
                android:importantForAccessibility="no"
                android:scaleType="fitStart" />

            <TextView
                android:id="@+id/widget_reset_2"
                style="@style/Widget.Broski.UsageCaption"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
