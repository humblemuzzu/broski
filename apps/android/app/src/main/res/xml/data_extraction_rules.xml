<?xml version="1.0" encoding="utf-8"?>
<!-- The vault is sealed with an Android Keystore key, which never leaves this device: a copy of the
     data elsewhere could not be opened, and a phone's pairings belong to this phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
