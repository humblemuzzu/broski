<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: the instrumented tests POST decision letters to a relay stand-in on the
     device's own loopback, over plain HTTP. Release builds use the main config, which allows none. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
