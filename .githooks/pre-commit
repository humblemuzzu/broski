#!/bin/sh
# Pre-commit hook: lint, typecheck and format-check what is staged.
# Install: git config core.hooksPath .githooks

set -e

ROOT=$(git rev-parse --show-toplevel)

echo "🔍 Pre-commit checks..."

# ── Bridge (only if bridge files staged) ──────────────────────────────────────

if [ -n "$(git diff --cached --name-only -- packages/bridge/ | head -1)" ]; then
  echo "  → biome check (bridge, errors only)"
  (cd "$ROOT/packages/bridge" && bunx biome check src/ scripts/ --diagnostic-level=error)

  echo "  → tsc --noEmit (bridge)"
  (cd "$ROOT/packages/bridge" && bun run typecheck)
fi

# ── Broski Link (only if link files staged) ───────────────────────────────────

if [ -n "$(git diff --cached --name-only -- packages/link/ | head -1)" ]; then
  echo "  → cargo fmt --check (link)"
  (cd "$ROOT/packages/link" && cargo fmt --all --check)
fi

# ── The apps (only if app files staged) ───────────────────────────────────────

if [ -n "$(git diff --cached --name-only -- apps/ios/ apps/android/ scripts/agent-text-allowlist.txt | head -1)" ]; then
  echo "  → agent text through the formatter (apps)"
  "$ROOT/scripts/check-agent-text.sh"
fi

echo "✅ All checks passed"
