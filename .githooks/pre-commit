#!/bin/sh
# Pre-commit hook: auto-format, lint, and typecheck before every commit.
# Install: git config core.hooksPath .githooks

set -e

echo "🔍 Pre-commit checks..."

# ── Flutter / Dart ────────────────────────────────────────────────────────────

# Auto-format and restage (don't just check — FIX it)
echo "  → dart format (auto-fix + restage)"
dart format lib/ test/
# Restage any files that were reformatted
git diff --name-only -- 'lib/*.dart' 'test/*.dart' 2>/dev/null | while read -r f; do
  [ -n "$f" ] && git add "$f"
done

echo "  → dart analyze"
dart analyze --fatal-warnings

# ── Bridge (only if bridge files staged) ──────────────────────────────────────

BRIDGE_CHANGED=$(git diff --cached --name-only -- packages/bridge/ | head -1)
if [ -n "$BRIDGE_CHANGED" ]; then
  echo "  → biome check (bridge, errors only)"
  cd packages/bridge && npx biome check src/ --diagnostic-level=error

  echo "  → tsc --noEmit (bridge)"
  bun run typecheck

  cd ../..
fi

echo "✅ All checks passed"
