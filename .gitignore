# macOS and editors
.DS_Store
*.swp
.idea/
*.iml
.vscode/
xcuserdata/
*.xcuserstate

# Secrets
.env
.env.*
!.env.example
# The maintainer's own names, addresses and ids that scripts/check-personal-info.sh refuses
.private/

# Bun and TypeScript (packages/bridge)
node_modules/
dist/
packages/bridge/src/_bootstrap_embedded.ts
packages/bridge/bench/results/
# Only the bridge's lockfile is committed: CI installs from it.
bun.lock
bun.lockb
!packages/bridge/bun.lock
package-lock.json
yarn.lock
pnpm-lock.yaml

# Rust (packages/link)
target/

# Swift and Xcode (apps/ios/*/.gitignore name each app's generated files)
.build/
.swiftpm/
DerivedData/
*.xcarchive
*.ipa

# Android and Gradle (apps/android/.gitignore names the generated modules' files)
.gradle/
.kotlin/
local.properties
*.apk
*.aab

# Python (scripts/lib)
__pycache__/
*.pyc

# Logs
*.log

# Local state of agents and tools
.worktrees/
.pi/
.asc/
.claude/*
!.claude/commands/
