<?xml version="1.0" encoding="utf-8"?>
<!--
    Cleartext is permitted for direct LAN connections to broski-link on the
    user's own machine. The link payload is Noise-encrypted end to end, so the
    transport underneath it needs no TLS. Relay connections use wss://.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
