<?xml version="1.0" encoding="utf-8"?>
<!--
    Cleartext is permitted for local bridge connections over WiFi.
    The bridge runs on the user's own machine on the local network.
    All remote connections (Tailscale Funnel) use TLS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
