{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["bun-types"]
  },
  "include": [
    "src/**/*.ts",
    "bench/**/*.ts",
    "scripts/measure-session-lists.ts",
    "scripts/gen-contract.ts",
    "scripts/check-layers.ts",
    "scripts/contract-gen/**/*.ts",
    "scripts/mutate-core.ts",
    "scripts/mutate-core/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
