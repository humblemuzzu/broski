{
  "name": "broski-bridge",
  "version": "0.1.0",
  "description": "Bridge server connecting Broski mobile app to AI coding agents (Claude Code, Pi)",
  "author": "humblemuzzu <broskiappp@gmail.com>",
  "license": "MIT",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/humblemuzzu/broski.git",
    "directory": "packages/bridge"
  },
  "homepage": "https://github.com/humblemuzzu/broski#readme",
  "bugs": {
    "url": "https://github.com/humblemuzzu/broski/issues"
  },
  "keywords": [
    "claude-code",
    "pi",
    "ai",
    "coding-agent",
    "mobile",
    "bridge",
    "websocket",
    "bun",
    "claude"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "bin": {
    "broski": "./bin/broski.ts",
    "broski-bridge": "./bin/broski.ts"
  },
  "files": [
    "bin",
    "src",
    "README.md"
  ],
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "bench": "bun bench/run.ts",
    "build": "sh scripts/build.sh",
    "build:mac": "sh scripts/build.sh --target darwin-arm64",
    "build:mac-intel": "sh scripts/build.sh --target darwin-x64",
    "build:linux": "sh scripts/build.sh --target linux-x64",
    "build:linux-arm": "sh scripts/build.sh --target linux-arm64",
    "build:windows": "sh scripts/build.sh --target windows-x64",
    "lint": "biome check src/ scripts/",
    "format": "biome format --write src/",
    "typecheck": "tsc --noEmit",
    "check": "biome check src/ scripts/ && tsc --noEmit",
    "contract:gen": "bun scripts/gen-contract.ts",
    "contract:check": "bun scripts/gen-contract.ts --check",
    "check:layers": "bun scripts/check-layers.ts",
    "mutate:core": "bun scripts/mutate-core.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.2.92",
    "@clack/prompts": "^1.0.0",
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "cross-spawn": "^7.0.6",
    "ignore": "^7.0.5",
    "minimatch": "^10.2.6",
    "picocolors": "^1.1.1",
    "zod": "4.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@types/bun": "^1.4.2",
    "@types/cross-spawn": "^6.0.6",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
